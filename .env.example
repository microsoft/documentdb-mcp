# MCP transport: streamable-http, sse, or stdio.
TRANSPORT='streamable-http'
HOST='localhost'
PORT='8070'

# HTTP and SSE authentication.
AUTH_REQUIRED='true'
ENTRA_TENANT_ID='<tenant-id>'
ENTRA_AUDIENCE='<application-client-id-or-api-audience>'

# Basic per-IP rate limiting for HTTP and SSE endpoints.
RATE_LIMIT_ENABLED='true'
RATE_LIMIT_WINDOW_MS='60000'
RATE_LIMIT_MAX_REQUESTS='120'

# Claim values mapped to MCP roles. Values may come from roles, groups, or scp claims.
MCP_READ_ROLE_VALUES='DocumentDB.MCP.Read'
MCP_WRITE_ROLE_VALUES='DocumentDB.MCP.Write'
MCP_MANAGEMENT_ROLE_VALUES='DocumentDB.MCP.Management'

# Capability gates. Keep higher-impact tools disabled until explicitly needed.
ENABLE_READ_TOOLS='true'
ENABLE_WRITE_TOOLS='false'
ENABLE_MANAGEMENT_TOOLS='false'
ALLOW_AGGREGATE_WRITE_STAGES='false'

# Trust local stdio only when the MCP server is launched by a trusted local client.
TRUST_LOCAL_STDIO='false'

# Optional local-stdio convenience: when set, tools may omit connection_profile.
# Only supported with TRANSPORT=stdio.
# DEFAULT_CONNECTION_PROFILE='local'

# Recommended production profile: backend Entra/OIDC via DefaultAzureCredential.
# Run `az login --tenant <tenant-id>` for local development, or use managed identity in Azure.
CONNECTION_PROFILES='{"sandbox":{"authMode":"entra","endpoint":"example.mongocluster.cosmos.azure.com","tokenScope":"https://ossrdbms-aad.database.windows.net/.default","allowedHosts":["*.mongocluster.cosmos.azure.com"]}}'

# Optional legacy SCRAM profile for local or sandbox use only.
# CONNECTION_PROFILES='{"local":{"uriEnv":"DOCUMENTDB_LOCAL_URI"}}'
# DOCUMENTDB_LOCAL_URI='mongodb://localhost:27017'

# Optional profile file with the same JSON shape as CONNECTION_PROFILES.
# CONNECTION_PROFILES_FILE='/etc/documentdb-mcp/profiles.json'

