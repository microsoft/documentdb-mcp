{
  "name": "documentdb-mcp-server",
  "version": "0.1.0",
  "description": "Tools-only MCP server for Azure Cosmos DB for MongoDB vCore and MongoDB-compatible DocumentDB deployments",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    ".env.example",
    "tool_list.md",
    "LICENSE.md"
  ],
  "exports": {
    ".": "./dist/index.js",
    "./server": "./dist/server.js"
  },
  "main": "dist/main.js",
  "bin": {
    "documentdb-mcp-server": "dist/main.js"
  },
  "scripts": {
    "build": "tsc --build --force",
    "start": "node dist/main.js",
    "dev": "tsx src/main.ts",
    "test": "vitest run",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "prepare": "npm run build",
    "prepack": "npm run clean && npm run build",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@azure/identity": "^4.13.1",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "dotenv": "^16.4.1",
    "express": "^4.22.2",
    "express-rate-limit": "^7.5.0",
    "jose": "^5.10.0",
    "mongodb": "^6.3.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/express": "^4.17.0",
    "@types/node": "^20.11.0",
    "prettier": "^3.2.5",
    "prettier-plugin-organize-imports": "^3.2.4",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0",
    "vitest": "^4.1.8"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
