{
    "servers": {
        "DocumentDB_stdio": {
            "type": "stdio",
            "command": "uv",
            "args": [
                "run",
                "--with",
                "mcp[cli],pymongo>=4.12.0",
                "mcp",
                "run",
                "your_script_path"
            ],
            "env": {
                // DocumentDB connection settings:
                // - DOCUMENTDB_URI: The connection string to your DocumentDB instance
                // - DB_NAME: The name of the database to connect to
                // Note: These values should be updated with your actual database credentials
                "DOCUMENTDB_URI": "your_connection_string",
                "DB_NAME": "your_db_name",
            }
        },
            "DocumentDB_sse": {
            "type": "sse",
            "url": "http://localhost:8070/sse",
        }
    }
}